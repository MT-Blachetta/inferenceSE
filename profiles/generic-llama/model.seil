; LLaMA-family decoder, Hugging Face tensor names.
program llama

func main(%tokens) -> %logits
  %x = embed @"model.embed_tokens.weight", %tokens
  for i in range(cfg.num_hidden_layers)
    %x = call block(i, %x)
  end
  %x = last %x
  %x = rmsnorm %x, @"model.norm.weight", eps=cfg.rms_norm_eps
  %logits = linear %x, @"lm_head.weight"
  ret %logits
end

func block(i, %x) -> %x
  %h = rmsnorm %x, @"model.layers.{i}.input_layernorm.weight", eps=cfg.rms_norm_eps
  %a = attention %h, q=@"model.layers.{i}.self_attn.q_proj.weight", \
                     k=@"model.layers.{i}.self_attn.k_proj.weight", \
                     v=@"model.layers.{i}.self_attn.v_proj.weight", \
                     o=@"model.layers.{i}.self_attn.o_proj.weight", \
                     heads=cfg.num_attention_heads, \
                     kv_heads=cfg.get("num_key_value_heads", cfg.num_attention_heads), \
                     rope_theta=cfg.get("rope_theta", 10000.0), key=f"attn.{i}"
  %x = add %x, %a
  %h = rmsnorm %x, @"model.layers.{i}.post_attention_layernorm.weight", eps=cfg.rms_norm_eps
  %g = linear %h, @"model.layers.{i}.mlp.gate_proj.weight"
  %u = linear %h, @"model.layers.{i}.mlp.up_proj.weight"
  %g = silu %g
  %m = mul %g, %u
  %m = linear %m, @"model.layers.{i}.mlp.down_proj.weight"
  %x = add %x, %m
  ret %x
end
